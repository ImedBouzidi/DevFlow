# Flask runtime
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# API
API_PREFIX=/api/v1

# Model artifacts
MODEL_DIR=ml-models
SEVERITY_MODEL_FILE=severity_model (1).joblib
CATEGORY_MODEL_FILE=category_model (1).joblib
RESOLUTION_TIME_MODEL_FILE=resolution_time_model (1).joblib
EAGER_LOAD_MODELS=false
