# Copy to infrastructure/.env for local overrides.
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow
POSTGRES_PORT=5432

KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Must match the local dev service-client secret in keycloak/devflow-realm.json.
KEYCLOAK_ADMIN_CLIENT_SECRET=devflow-local-change-me
